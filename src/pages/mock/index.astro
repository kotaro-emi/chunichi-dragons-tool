---
import Layout from '../../layouts/Layout.astro';
import TabGroup from '../../components/TabGroup.astro';
import StatChip from '../../components/StatChip.astro';
import { attendanceOverview, farmOverview, todayGame } from '../../lib/mock-team';
import { mockPlayers } from '../../lib/mock-players';

const base = import.meta.env.BASE_URL;
const notablePlayer = mockPlayers.find((p) => p.slug === farmOverview.notablePlayerSlug);

const sections = [
  { href: `${base}players/`, title: '選手一覧', desc: '打者29名・投手29名の実成績をタブ切替。個別ページで成績/応援歌/プロフィールを表示。', emoji: '⚾' },
  { href: `${base}mock/scores/`, title: '試合結果・速報', desc: '今日の試合の要約・MVP・イニング経過（Phase 6で実データ反映）', emoji: '📡' },
  { href: `${base}history/`, title: '球団の歴史', desc: '1936年創設からの年表・球団情報（実データ実装済み）', emoji: '📜' },
  { href: `${base}reinforcement/`, title: '補強ポイント', desc: 'AIによる定期分析（実データ実装済み）', emoji: '🧭' },
];
---

<Layout title="ドラゴンズ手帳（デザインモック）">
  <section class="mb-8">
    <h1 class="font-[family-name:var(--font-brand)] text-3xl text-navy-900 sm:text-4xl">ドラゴンズ手帳</h1>
    <p class="mt-2 text-sm text-ink-soft">
      歴史・成績・選手情報・応援歌・補強ポイント・試合速報が一目でわかるファンアプリ（デザインモック）
    </p>
  </section>

  <TabGroup tabs={[{ id: 'today', label: '今日の中日' }, { id: 'links', label: 'コンテンツ一覧' }]}>
    <div data-tab-panel="today">
      <a
        href={`${base}mock/scores/`}
        class="mb-6 flex items-center justify-between rounded-lg bg-gradient-to-br from-navy-900 to-navy-700 p-4 text-paper transition hover:opacity-95"
      >
        <div>
          <p class="text-xs opacity-80">本日のスコア（対 {todayGame.opponent}）</p>
          <p class="mt-1 font-[family-name:var(--font-mincho)] text-xl">{todayGame.result}</p>
        </div>
        <span class="text-sm opacity-80">試合速報を見る →</span>
      </a>

      <h2 class="mb-3 font-[family-name:var(--font-mincho)] text-sm text-blue-accent">観客動員数</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <StatChip label="本日" value={`${attendanceOverview.todayAttendance.toLocaleString()}人`} />
        <StatChip label="入場率" value={`${Math.round(attendanceOverview.todayCapacityPct * 100)}%`} />
        <StatChip label="シーズン累計" value={`${attendanceOverview.seasonTotal.toLocaleString()}人`} />
        <StatChip label="リーグ内順位" value={`${attendanceOverview.seasonRank}位`} />
      </div>

      <h2 class="mt-6 mb-3 font-[family-name:var(--font-mincho)] text-sm text-blue-accent">二軍の情報</h2>
      <div class="rounded-lg border border-card-border bg-paper p-4 text-sm">
        <p class="text-ink-soft">
          二軍順位：<span class="font-semibold text-ink">{farmOverview.standingRank}位</span>
        </p>
        <p class="mt-1 text-ink">{farmOverview.note}</p>
        {
          notablePlayer && (
            <a
              href={`${base}mock/players/${notablePlayer.slug}/`}
              class="mt-3 inline-block text-blue-accent underline decoration-blue-accent/40 underline-offset-2 hover:decoration-blue-accent"
            >
              注目の二軍選手：{notablePlayer.name} のページを見る →
            </a>
          )
        }
      </div>
    </div>

    <div data-tab-panel="links" hidden>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          sections.map((s) => (
            <a
              href={s.href}
              class="group rounded-xl border border-card-border bg-paper p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <div class="mb-2 text-2xl">{s.emoji}</div>
              <h3 class="font-[family-name:var(--font-mincho)] text-lg text-ink group-hover:text-blue-accent">
                {s.title}
              </h3>
              <p class="mt-1 text-sm text-ink-soft">{s.desc}</p>
            </a>
          ))
        }
      </div>
    </div>
  </TabGroup>
</Layout>
