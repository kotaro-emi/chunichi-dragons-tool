---
import Layout from '../../../layouts/Layout.astro';
import PlayerTabs from '../../../components/PlayerTabs.astro';
import PlayerAvatar from '../../../components/PlayerAvatar.astro';
import { mockPlayers } from '../../../lib/mock-players';

export function getStaticPaths() {
  return mockPlayers.map((player) => ({
    params: { slug: player.slug },
    props: { player },
  }));
}

const { player } = Astro.props;
const base = import.meta.env.BASE_URL;
const roleLabel = player.role === 'batter' ? '野手' : '投手';
---

<Layout title={`${player.name}｜ドラゴンズ手帳（デザインモック）`}>
  <nav class="mb-4 flex gap-3 text-sm">
    {
      mockPlayers.map((p) => (
        <a
          href={`${base}mock/players/${p.slug}/`}
          class={`rounded-full border px-3 py-1 ${
            p.slug === player.slug
              ? 'border-blue-accent bg-blue-accent-soft text-blue-accent'
              : 'border-card-border text-ink-soft hover:text-ink'
          }`}
        >
          {p.name}（{p.role === 'batter' ? '野手' : '投手'}・{p.level}）
        </a>
      ))
    }
  </nav>

  <header class="mb-6 flex items-center gap-4">
    <PlayerAvatar name={player.name} role={player.role} />
    <div>
      <h1 class="font-[family-name:var(--font-mincho)] text-2xl text-navy-900 sm:text-3xl">{player.name}</h1>
      <div class="mt-1 flex gap-2">
        <span
          class={`inline-block rounded-full px-3 py-1 text-xs text-paper ${
            player.role === 'pitcher' ? 'bg-call-red' : 'bg-navy-800'
          }`}
        >
          {roleLabel}
        </span>
        <span class="inline-block rounded-full border border-card-border px-3 py-1 text-xs text-ink-soft">
          {player.level}
        </span>
      </div>
    </div>
  </header>

  <PlayerTabs player={player} />
</Layout>
