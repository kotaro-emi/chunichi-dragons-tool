---
import Layout from '../../../layouts/Layout.astro';
import TabGroup from '../../../components/TabGroup.astro';
import { todayGame, inningScores } from '../../../lib/mock-team';

const totalChunichi = inningScores.reduce((sum, i) => sum + i.chunichi, 0);
const totalOpponent = inningScores.reduce((sum, i) => sum + i.opponent, 0);
---

<Layout title="試合結果・速報｜ドラゴンズ手帳（デザインモック）">
  <header class="mb-6">
    <h1 class="font-[family-name:var(--font-mincho)] text-2xl text-navy-900 sm:text-3xl">試合結果・速報</h1>
    <p class="mt-2 text-sm text-ink-soft">
      ※ ダミーデータです。実際の更新は数分〜十数分ごと（開発計画書3.6節）を想定しています。
    </p>
  </header>

  <TabGroup tabs={[{ id: 'today', label: '今日の試合' }, { id: 'innings', label: 'イニング経過' }]}>
    <div data-tab-panel="today">
      <div class="rounded-lg bg-gradient-to-br from-navy-900 to-navy-700 p-5 text-paper">
        <p class="text-xs opacity-80">{todayGame.venue}</p>
        <p class="mt-1 font-[family-name:var(--font-mincho)] text-xl">{todayGame.result}</p>
        <p class="mt-1 text-sm opacity-90">対 {todayGame.opponent}</p>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-ink">{todayGame.summary}</p>

      <div class="mt-4 rounded-lg border border-call-red/40 bg-call-red-soft p-4">
        <p class="text-xs font-semibold text-call-red">本日のMVP</p>
        <p class="mt-1 font-[family-name:var(--font-mincho)] text-lg text-ink">{todayGame.mvp.name}</p>
        <p class="mt-1 text-sm text-ink-soft">{todayGame.mvp.note}</p>
      </div>
    </div>

    <div data-tab-panel="innings" hidden>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[420px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-card-border text-ink-soft">
              <th class="py-2 text-left font-normal">チーム</th>
              {inningScores.map((i) => (
                <th class="w-8 py-2 text-center font-normal">{i.inning}</th>
              ))}
              <th class="w-10 py-2 text-center font-semibold text-ink">計</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-card-border">
              <td class="py-2 font-semibold text-blue-accent">中日</td>
              {inningScores.map((i) => (
                <td class="text-center">{i.chunichi}</td>
              ))}
              <td class="text-center font-semibold text-ink">{totalChunichi}</td>
            </tr>
            <tr>
              <td class="py-2 text-ink-soft">{todayGame.opponent}</td>
              {inningScores.map((i) => (
                <td class="text-center">{i.opponent}</td>
              ))}
              <td class="text-center font-semibold text-ink">{totalOpponent}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </TabGroup>
</Layout>
