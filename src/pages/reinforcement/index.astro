---
import Layout from '../../layouts/Layout.astro';
import { getReinforcementEntries, reinforcementDisclaimer } from '../../lib/reinforcement';

const entries = getReinforcementEntries();
---

<Layout title="補強ポイント｜ドラゴンズ手帳">
  <header class="mb-6">
    <h1 class="font-[family-name:var(--font-mincho)] text-2xl text-navy-900 sm:text-3xl">補強ポイント（AI分析）</h1>
  </header>

  <div class="mb-8 rounded-lg border border-call-red/40 bg-call-red-soft p-4 text-sm text-call-red">
    {reinforcementDisclaimer}
  </div>

  <div class="space-y-10">
    {
      entries.map((entry) => (
        <article class="rounded-xl border border-card-border bg-card p-5">
          <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
            <p class="text-xs text-ink-soft">生成日: {entry.generatedAt} ／ 分析対象: {entry.basedOn}</p>
          </div>
          <p class="mb-6 text-sm leading-relaxed text-ink">{entry.summary}</p>
          <div class="grid gap-4 sm:grid-cols-2">
            {entry.points.map((point) => (
              <div class="rounded-lg border border-card-border bg-paper p-4">
                <span class="mb-1 inline-block rounded-full bg-blue-accent-soft px-2 py-0.5 text-xs text-blue-accent">
                  {point.category}
                </span>
                <h3 class="mt-1 mb-1 font-[family-name:var(--font-mincho)] text-base text-ink">{point.title}</h3>
                <p class="text-sm leading-relaxed text-ink-soft">{point.body}</p>
              </div>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</Layout>
