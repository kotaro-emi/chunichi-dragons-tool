---
import Layout from '../../layouts/Layout.astro';
import TabGroup from '../../components/TabGroup.astro';
import PlayerAvatar from '../../components/PlayerAvatar.astro';
import { getBatters, getPitchers, fmt3, ops, playersUpdatedAt } from '../../lib/players';

const base = import.meta.env.BASE_URL;
const batters = getBatters();
const pitchers = getPitchers();
---

<Layout title="選手一覧｜ドラゴンズ手帳">
  <header class="mb-6">
    <h1 class="font-[family-name:var(--font-mincho)] text-2xl text-navy-900 sm:text-3xl">選手一覧</h1>
    <p class="mt-2 text-sm text-ink-soft">NPB公式サイトのデータをもとにした{playersUpdatedAt}時点の一軍成績です。</p>
  </header>

  <TabGroup tabs={[{ id: 'batters', label: `打者（${batters.length}）` }, { id: 'pitchers', label: `投手（${pitchers.length}）` }]}>
    <div data-tab-panel="batters">
      <p class="mb-4 text-xs text-ink-soft">打席数の多い順に表示しています。</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          batters.map((p) => (
            <a
              href={`${base}players/${p.slug}/`}
              class="flex items-center gap-4 rounded-xl border border-card-border bg-card p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <PlayerAvatar name={p.name} role="batter" />
              <div class="min-w-0 flex-1">
                <p class="truncate font-[family-name:var(--font-mincho)] text-base text-ink">{p.name}</p>
                <p class="text-xs text-ink-soft">{p.battingStats?.pa}打席 / {p.battingStats?.g}試合</p>
                <div class="mt-2 flex flex-wrap gap-2 text-xs">
                  <span class="rounded-full bg-blue-accent-soft px-2 py-0.5 text-blue-accent">打率{p.battingStats && fmt3(p.battingStats.avg)}</span>
                  <span class="rounded-full bg-paper px-2 py-0.5 text-ink-soft">本{p.battingStats?.hr}</span>
                  <span class="rounded-full bg-paper px-2 py-0.5 text-ink-soft">点{p.battingStats?.rbi}</span>
                  <span class="rounded-full bg-paper px-2 py-0.5 text-ink-soft">OPS{p.battingStats && fmt3(ops(p.battingStats))}</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>

    <div data-tab-panel="pitchers" hidden>
      <p class="mb-4 text-xs text-ink-soft">対戦打者数の多い順に表示しています。</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          pitchers.map((p) => (
            <a
              href={`${base}players/${p.slug}/`}
              class="flex items-center gap-4 rounded-xl border border-card-border bg-card p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <PlayerAvatar name={p.name} role="pitcher" />
              <div class="min-w-0 flex-1">
                <p class="truncate font-[family-name:var(--font-mincho)] text-base text-ink">{p.name}</p>
                <p class="text-xs text-ink-soft">{p.pitchingStats?.ip}回 / {p.pitchingStats?.g}登板</p>
                <div class="mt-2 flex flex-wrap gap-2 text-xs">
                  <span class="rounded-full bg-call-red-soft px-2 py-0.5 text-call-red">防御率{p.pitchingStats?.era}</span>
                  <span class="rounded-full bg-paper px-2 py-0.5 text-ink-soft">{p.pitchingStats?.w}勝{p.pitchingStats?.l}敗</span>
                  <span class="rounded-full bg-paper px-2 py-0.5 text-ink-soft">奪三振{p.pitchingStats?.so}</span>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </TabGroup>
</Layout>
