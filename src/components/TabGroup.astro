---
interface Props {
  tabs: { id: string; label: string }[];
}

const { tabs } = Astro.props;
---

<div data-tabs class="rounded-xl border border-card-border bg-card">
  <div role="tablist" class="flex flex-wrap gap-1 border-b border-card-border p-2">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-tab-btn={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="tab-btn rounded-lg px-3 py-2 text-sm font-medium text-ink-soft transition-colors aria-selected:bg-blue-accent-soft aria-selected:text-blue-accent"
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div class="p-5">
    <slot />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((wrapper) => {
    const buttons = wrapper.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
    const panels = wrapper.querySelectorAll<HTMLElement>(':scope > div > [data-tab-panel]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tabBtn;
        buttons.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
        panels.forEach((p) => {
          p.hidden = p.dataset.tabPanel !== target;
        });
      });
    });
  });
</script>
