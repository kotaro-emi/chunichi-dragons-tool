---
import type { Player } from '../lib/players';
import { fmt3, ops } from '../lib/players';
import StatChip from './StatChip.astro';

interface Props {
  player: Player;
}

const { player } = Astro.props;

const tabs = [
  { id: 'profile', label: 'プロフィール' },
  { id: 'stats', label: '成績' },
  { id: 'cheer', label: '応援歌' },
];
---

<div data-tabs class="rounded-xl border border-card-border bg-card">
  <div role="tablist" class="flex flex-wrap gap-1 border-b border-card-border p-2">
    {
      tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-tab-btn={tab.id}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="tab-btn rounded-lg px-3 py-2 text-sm font-medium text-ink-soft transition-colors aria-selected:bg-blue-accent-soft aria-selected:text-blue-accent"
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div class="p-5">
    <div data-tab-panel="profile">
      <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
        <dt class="text-ink-soft">区分</dt>
        <dd>{player.role === 'batter' ? '野手' : '投手'}・{player.level}</dd>
        {
          player.throws && (
            <>
              <dt class="text-ink-soft">投球</dt>
              <dd>{player.throws}投</dd>
            </>
          )
        }
      </dl>
      <p class="mt-4 rounded-lg border border-card-border bg-paper p-3 text-sm leading-relaxed text-ink-soft">
        生年月日・出身地・経歴などのプロフィール情報は、まだデータソースを確定できておらず準備中です。データが揃い次第この欄に追加します。
      </p>
    </div>

    <div data-tab-panel="stats" hidden>
      {
        player.role === 'batter' && player.battingStats && (
          <div class="space-y-5">
            <div>
              <h3 class="mb-2 font-[family-name:var(--font-mincho)] text-sm text-blue-accent">打撃成績</h3>
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                <StatChip label="試合" value={`${player.battingStats.g}`} />
                <StatChip label="打率" value={fmt3(player.battingStats.avg)} />
                <StatChip label="本塁打" value={`${player.battingStats.hr}`} />
                <StatChip label="打点" value={`${player.battingStats.rbi}`} />
                <StatChip label="安打" value={`${player.battingStats.h}`} />
                <StatChip label="盗塁" value={`${player.battingStats.sb}`} />
                <StatChip label="四球" value={`${player.battingStats.bb}`} />
                <StatChip label="三振" value={`${player.battingStats.so}`} />
                <StatChip label="OPS" value={fmt3(ops(player.battingStats))} />
              </div>
            </div>
          </div>
        )
      }
      {
        player.role === 'pitcher' && player.pitchingStats && (
          <div class="space-y-5">
            <div>
              <h3 class="mb-2 font-[family-name:var(--font-mincho)] text-sm text-blue-accent">投手成績</h3>
              <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                <StatChip label="登板" value={`${player.pitchingStats.g}`} />
                <StatChip label="防御率" value={player.pitchingStats.era} />
                <StatChip label="勝敗" value={`${player.pitchingStats.w}勝${player.pitchingStats.l}敗`} />
                <StatChip label="セーブ" value={`${player.pitchingStats.sv}`} />
                <StatChip label="ホールド" value={`${player.pitchingStats.hld}`} />
                <StatChip label="投球回" value={player.pitchingStats.ip} />
                <StatChip label="奪三振" value={`${player.pitchingStats.so}`} />
                <StatChip label="与四球" value={`${player.pitchingStats.bb}`} />
                <StatChip label="被安打" value={`${player.pitchingStats.h}`} />
              </div>
            </div>
            <p class="text-xs text-ink-soft">※球種・最速球速のデータは未整備のため表示していません。</p>
          </div>
        )
      }

      {
        player.fieldingStats.length > 0 && (
          <div class="mt-6 space-y-4">
            <h3 class="mb-2 font-[family-name:var(--font-mincho)] text-sm text-blue-accent">守備成績</h3>
            {player.fieldingStats.map((f) => (
              <div>
                <p class="mb-1 text-xs font-semibold text-ink-soft">{f.position}</p>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                  <StatChip label="試合" value={`${f.g}`} />
                  <StatChip label="刺殺" value={`${f.po}`} />
                  <StatChip label="補殺" value={`${f.a}`} />
                  <StatChip label="失策" value={`${f.e}`} />
                  <StatChip label="併殺" value={`${f.dp}`} />
                  <StatChip label="守備率" value={f.fpct} />
                  {f.passedBalls !== undefined && <StatChip label="捕逸" value={`${f.passedBalls}`} />}
                  {f.caughtStealingPct !== undefined && <StatChip label="盗塁阻止率" value={f.caughtStealingPct} />}
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>

    <div data-tab-panel="cheer" hidden>
      {
        player.cheerSong ? (
          <div>
            <div class="rounded-lg bg-navy-900 px-5 py-4 text-paper">
              {player.cheerSong.variants.map((variant) => (
                <div class="mb-3 last:mb-0">
                  {variant.label && <p class="mb-1 text-xs uppercase tracking-wide text-white/60">{variant.label}</p>}
                  {variant.lines.map((line) => (
                    <p class="font-[family-name:var(--font-mincho)] text-sm leading-8">{line}</p>
                  ))}
                </div>
              ))}
              <p class="mt-2 text-xs text-call-red">{player.cheerSong.callLine}</p>
            </div>
            <p class="mt-2 text-xs text-ink-soft">※著作権への配慮のため歌詞は一部抜粋です。</p>
          </div>
        ) : (
          <p class="text-sm text-ink-soft">
            この選手専用の応援歌は確認できていません。個別の応援歌が無い場合は「野手汎用テーマ」が使われることがあります。
          </p>
        )
      }
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((wrapper) => {
    const buttons = wrapper.querySelectorAll<HTMLButtonElement>('[data-tab-btn]');
    const panels = wrapper.querySelectorAll<HTMLElement>('[data-tab-panel]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tabBtn;
        buttons.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
        panels.forEach((p) => {
          p.hidden = p.dataset.tabPanel !== target;
        });
      });
    });
  });
</script>
