---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Yuji+Boku&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=RocknRoll+One&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ storageKey: 'theme' }}>
      // ページ描画前にテーマを適用し、切り替わりのチラつきを防ぐ
      const saved = localStorage.getItem(storageKey);
      if (saved === 'dark' || saved === 'light') {
        document.documentElement.setAttribute('data-theme', saved);
      }
    </script>
  </head>
  <body class="min-h-screen font-[family-name:var(--font-gothic)]">
    <header class="relative overflow-hidden bg-gradient-to-r from-navy-900 via-navy-800 to-navy-700 px-6 py-5 text-paper">
      <div class="absolute inset-x-0 top-0 h-0.5 bg-call-red"></div>
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3">
        <a href={base} class="font-[family-name:var(--font-brand)] text-xl tracking-wide sm:text-2xl">
          ドラゴンズ手帳
        </a>
        <nav class="flex flex-wrap items-center gap-4 text-sm">
          <a href={`${base}mock/`} class="opacity-80 transition hover:opacity-100">トップ</a>
          <a href={`${base}mock/players/abe-juki/`} class="opacity-80 transition hover:opacity-100">選手一覧</a>
          <button
            id="theme-toggle"
            type="button"
            class="rounded-full border border-white/30 px-3 py-1 text-xs opacity-90 transition hover:opacity-100"
            aria-label="ライト/ダーク表示を切り替える"
          >
            🌓 表示切替
          </button>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-4 pb-10 text-xs text-ink-soft">
      <p>※ Phase 1 デザインモック（ダミーデータ表示）。実データは Phase 2〜3 で反映予定。</p>
    </footer>

    <script is:inline define:vars={{ storageKey: 'theme' }}>
      const btn = document.getElementById('theme-toggle');
      const root = document.documentElement;
      btn?.addEventListener('click', () => {
        const current = root.getAttribute('data-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const currentlyDark = current ? current === 'dark' : prefersDark;
        const next = currentlyDark ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        localStorage.setItem(storageKey, next);
      });
    </script>
  </body>
</html>
